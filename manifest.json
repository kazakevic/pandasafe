{
  "manifest_version": 3,
  "name": "PandaSafe",
  "version": "0.3.0",
  "description": "Blocks the websites you choose, YouTube Shorts and YouTube channels.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "PandaSafe",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["declarativeNetRequest", "storage", "favicon"],
  "host_permissions": ["<all_urls>"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "block_shorts",
        "enabled": true,
        "path": "src/rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["src/blocked/blocked.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "css": ["src/youtube-shorts.css"],
      "js": ["src/shared.js", "src/youtube-shorts.js", "src/youtube-channels.js"],
      "run_at": "document_start"
    }
  ]
}
